VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google Calendar integration ─────────────────────────────────────────────
# These are SERVER-SIDE ONLY Supabase Edge Function secrets. They are NOT
# VITE_ vars and must never reach the frontend. Set them with:
#   supabase secrets set GOOGLE_CLIENT_ID=...        \
#                        GOOGLE_CLIENT_SECRET=...    \
#                        GOOGLE_REDIRECT_URI=...     \
#                        APP_URL=...                 \
#                        GOOGLE_STATE_SECRET=...
#
# GOOGLE_CLIENT_ID       OAuth client id (Google Cloud Console)
# GOOGLE_CLIENT_SECRET   OAuth client secret — secret, server-side only
# GOOGLE_REDIRECT_URI    https://<project>.supabase.co/functions/v1/google-calendar-callback
# APP_URL                Base URL of the app, e.g. https://app.bossbase.nl (callback redirects to APP_URL/calendar)
# GOOGLE_STATE_SECRET    Random string used to HMAC-sign the OAuth state (optional;
#                        falls back to SUPABASE_SERVICE_ROLE_KEY if unset)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
